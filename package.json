{
  "name": "merged-ai-agents",
  "version": "1.0.0",
  "description": "Merged AI Agent Platform",
  "main": "server/index.js",
  "scripts": {
    "test": "npm run test:env && npm run test:openai",
    "test:env": "node tests/env-test.js",
    "test:openai": "node tests/openai-test.js",
    "server": "node server/index.js",
    "client": "cd client && npm start",
    "dev": "concurrently \"npm run server\" \"npm run client\""
  },
  "dependencies": {
    "express": "^4.17.1",
    "openai": "^4.0.0",
    "dotenv": "^16.0.0",
    "mongoose": "^7.6.5",
    "mongodb": "^5.8.0",
    "mongodb-memory-server": "^8.0.0",
    "cors": "^2.8.5",
    "ws": "^8.13.0",
    "langchain": "^0.3.8",
    "@langchain/openai": "^0.3.16",
    "@langchain/community": "^0.3.21",
    "@langchain/core": "^0.3.9"
  },
  "devDependencies": {
    "nodemon": "^3.0.0",
    "concurrently": "^8.0.1"
  }
} 